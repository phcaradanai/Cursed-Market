      "css": ".ds-button-text{font:16px Tahoma, \"Noto Sans Thai\", sans-serif;line-height:1.5;min-height:44px;padding:9px 18px;border:1px solid #29251f;border-radius:4px;color:#29251f;background:transparent;cursor:pointer;border-color:transparent;text-decoration:underline;text-underline-offset:4px;padding-inline:5px;}.ds-button-text:hover:not(:disabled){background:#e7decd;}.ds-button-text:focus-visible{outline:3px solid #8b3925;outline-offset:4px;}.ds-button-text:disabled{opacity:.55;cursor:not-allowed;}"
    },
    {
      "name": "Legacy Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Legacy auction only. Visible label and pale field; native focus and selection.",
      "html": "<label class=\"ds-label\">ชื่อที่ใช้ในตลาด<input class=\"ds-input\" name=\"name\" maxlength=\"24\" placeholder=\"ชื่อของคุณ\"></label>",
      "css": ".ds-label{display:block;font:600 16px/1.65 Tahoma, \"Noto Sans Thai\", sans-serif;color:#29251f;}.ds-input{box-sizing:border-box;display:block;font:inherit;width:100%;min-height:46px;padding:9px 12px;margin-top:6px;border:1px solid #877b69;border-radius:4px;color:#29251f;background:#fffaf0;caret-color:#8b3925;}.ds-input::placeholder{color:#655c50;opacity:1;}.ds-input:focus-visible{outline:3px solid #8b3925;outline-offset:4px;}"
    },
    {
      "name": "Legacy Relic Choice",
      "kind": "card",
      "refersTo": "relic-choice",
      "description": "Legacy auction only. Native radio, neutral family SVG and private truth; selected border uses rust.",
      "html": "<label class=\"ds-relic-choice\"><input class=\"ds-relic-radio\" type=\"radio\" name=\"ds-relic\" checked><span class=\"ds-choice-number\">ชิ้นที่ 1</span><span class=\"ds-relic\"><svg class=\"ds-symbol\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"23\" cy=\"21\" r=\"12\"/><path d=\"m31 30 22 22m-7-7 7-7m-14 0 7-7\"/></svg><span class=\"ds-relic-title\">กุญแจ</span><span class=\"ds-truth\"><span>ของแท้</span><span class=\"ds-danger\">มีคำสาป</span></span></span></label>",
      "css": ".ds-relic-choice{display:block;font:600 16px/1.65 Tahoma, \"Noto Sans Thai\", sans-serif;color:#29251f;padding:18px;border:1px solid #c6bcaa;background:#fffaf0;cursor:pointer;position:relative;}.ds-relic-choice:has(input:checked){border-color:#8b3925;outline:1px solid #8b3925;}.ds-relic-radio{width:20px;min-height:20px;margin:0;accent-color:#8b3925;vertical-align:middle;}.ds-relic-radio:focus-visible{outline:3px solid #8b3925;outline-offset:4px;}.ds-choice-number{margin-left:9px;font-size:14px;vertical-align:middle;}.ds-relic{display:block;text-align:center;padding:12px;}.ds-symbol{width:64px;height:64px;margin-bottom:12px;color:#65533b;}.ds-relic-title{display:block;font-size:19px;line-height:1.55;margin:0;}.ds-truth{display:flex;justify-content:center;flex-wrap:wrap;gap:4px 16px;margin-top:8px;font-size:15px;}.ds-danger{color:#8b3925;font-weight:600;}@media(max-width:760px){.ds-relic-choice{padding:12px 8px;}.ds-truth{gap:3px;font-size:14px;}}"
    },
    {
      "name": "Legacy Phase Navigation",
      "kind": "nav",
      "refersTo": "phase-navigation",
      "description": "Legacy auction only. Informational phase row with an underlined current step; no interactive hover state.",
      "html": "<nav class=\"ds-phases\" aria-label=\"ขั้นตอนประมูล\"><span>ผู้ขายเลือกสินค้า</span><span aria-current=\"step\">ตรวจสินค้า</span><span>ประมูลแบบปิด</span><span>เปิดผลประมูล</span></nav>",
      "css": ".ds-phases{display:flex;gap:24px;flex-wrap:wrap;margin-bottom:28px;padding-bottom:14px;border-bottom:1px solid #c6bcaa;font:14px/1.65 Tahoma, \"Noto Sans Thai\", sans-serif;color:#655c50;}.ds-phases [aria-current]{color:#8b3925;font-weight:700;text-decoration:underline;text-underline-offset:7px;}@media(max-width:760px){.ds-phases{gap:9px 20px;}}"
    },
    {
      "name": "Legacy Private Finding",
      "kind": "custom",
      "refersTo": "private-finding",
      "description": "Legacy auction only. A private result names the known attribute and keeps the other explicitly unknown.",
      "html": "<p class=\"ds-finding\" role=\"status\">ผลตรวจเฉพาะคุณ: ของแท้ · อีกคุณสมบัติยังไม่ทราบ</p>",
      "css": ".ds-finding{font:16px/1.65 Tahoma, \"Noto Sans Thai\", sans-serif;max-width:70ch;padding:14px 18px;margin-block:15px;background:#e5ead9;color:#34432a;}"
    }
  ],
  "narrative": {
    "northStar": "Dimensional appraisal table",
    "overview": "The implemented v0.4 table pairs realistic merchant portraits and artifact art with a warm charcoal ground, bronze dividers and cream decision panels. Thai labels keep inspection, appraisal, accepted NPC quote, contract and purchase distinct. This descriptive north star records the active goal's working card direction; it is not a user-approved production identity.\n\nThe appraisal source authority is `src/appraisal-client/styles.css`, `App.tsx` and `components.tsx`. The independent legacy auction UI in `src/client` keeps its pale ground, dark ink, rust controls and neutral SVG relic symbols. All existing legacy frontmatter tokens remain available; the complete prior documents in `docs/art/appraisal-v0.4/legacy-design/` are unchanged. Layout direction belongs to `docs/art/appraisal-v0.4/direction.md`, and product scope belongs to `PRODUCT.md`.\n\nThis documentation records source declarations and behavior. The user's instruction **“หยุดตรวจภาพ ใช้ผลตรวจเดิม”** excludes new browser sessions, screenshots and image QA. The focused finish review in `docs/validation/appraisal-ui-review-v0.4.md` scored F1–F3 resolved through source/test evidence. Historical captures do not validate v0.4 rendering; final brand approval and human enjoyment remain open.",
    "keyCharacteristics": [
      "Realistic merchant and single-item art identifies the subject without revealing hidden truth.",
      "Charcoal information regions and cream appraisal panels use separate foreground and action colors.",
      "Thai reading text, visible native controls and explicit unknown facts support timed decisions.",
      "Fine region dividers, rounded art surfaces and one bounded artifact arrival effect define the implemented depth.",
      "Legacy auction primitives remain scoped to their independent interface."
    ],
    "rules": [
      {
        "name": "The Surface Pair Rule",
        "body": "Use the foreground, action and focus colors of the current table or paper surface together; do not mix their text treatments.",
        "section": "colors"
      },
      {
        "name": "The Legibility Rule",
        "body": "Preserve Thai line spacing and wrap user names before narrowing or clipping meaningful text.",
        "section": "typography"
      },
      {
        "name": "The Artifact Depth Rule",
        "body": "Keep the offset shadow on the artifact frame and entry portrait, and the arrival effect on the artifact frame; general information regions use their existing tonal separation and dividers.",
        "section": "elevation"
      },
      {
        "name": "The Property Scope Rule",
        "body": "An inspection of one attribute never visually implies knowledge of another attribute; illustrations identify item kind without exposing hidden facts.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** preserve visible Thai labels, explicit focus and wrapping names.",
      "**Do** keep appraisal and legacy token scopes separate when adding a screen.",
      "**Do** show item identity, viewer-known facts, cost, accepted quote and exact contract before commitment.",
      "**Do** use the same item art across hidden attribute combinations and keep its prompt provenance.",
      "**Do** preserve the reduced-motion override and opt-in sound default.",
      "**Do** describe source/test evidence separately from rendered quality and human fun."
    ],
    "donts": [
      "**Don't** communicate authenticity, curse, readiness or errors through color alone.",
      "**Don't** expose another viewer's private inspection facts through text, image variants or preview data.",
      "**Don't** slice the critique concept into functional UI assets or call it an approved comp.",
      "**Don't** treat the working realistic-card direction as final brand approval.",
      "**Don't** use historical captures or this source-only documentation as v0.4 browser, device or visual validation."
    ]
  }
}
