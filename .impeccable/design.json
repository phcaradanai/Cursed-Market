      "css": ".ds-appraisal-table{padding:16px;background:var(--table,#211b18);color:var(--cream,#f2e4cc);font:16px/1.7 \"Noto Sans Thai\",sans-serif;}.ds-appraisal-danger{font:16px/1.6 \"Noto Sans Thai\",sans-serif;min-height:44px;padding:8px 16px;border:1px solid var(--bronze,#a48251);border-radius:6px;background:transparent;color:var(--cream,#f2e4cc);cursor:pointer;background:var(--danger-wash,#422a27);border-color:var(--danger,#e4a99a);color:var(--danger,#e4a99a);}.ds-appraisal-danger:hover:not(:disabled){background:var(--panel,#302721);}.ds-appraisal-danger:focus-visible{outline:3px solid var(--focus,#f2ca83);outline-offset:3px;}.ds-appraisal-danger:disabled{opacity:.55;cursor:not-allowed;}"
    },
    {
      "name": "Paper Primary Button",
      "kind": "button",
      "refersTo": "appraisal-button-paper-primary",
      "description": "Cream appraisal-panel button; immediate hover, explicit keyboard focus and disabled feedback.",
      "html": "<div class=\"ds-appraisal-paper\"><button class=\"ds-appraisal-paper-primary\" type=\"button\">ยืนยันการประเมิน · 1 พลัง</button></div>",
      "css": ".ds-appraisal-paper{padding:24px;background:var(--cream,#f2e4cc);color:var(--ink,#30271f);border-radius:12px;color-scheme:light;font:16px/1.7 \"Noto Sans Thai\",sans-serif;}.ds-appraisal-paper-primary{font:16px/1.6 \"Noto Sans Thai\",sans-serif;min-height:44px;padding:8px 16px;border:1px solid var(--paper-line,#97836a);border-radius:6px;background:transparent;color:var(--ink,#30271f);cursor:pointer;background:var(--accent,#8b3925);border-color:var(--accent,#8b3925);color:var(--paper,#fffaf0);font-weight:700;}.ds-appraisal-paper-primary:hover:not(:disabled){background:var(--accent-hover,#6d2b1c);border-color:var(--accent-hover,#6d2b1c);}.ds-appraisal-paper-primary:focus-visible{outline:3px solid var(--accent,#8b3925);outline-offset:3px;}.ds-appraisal-paper-primary:disabled{opacity:.55;cursor:not-allowed;}"
    },
    {
      "name": "Paper Secondary Button",
      "kind": "button",
      "refersTo": "appraisal-button-paper-secondary",
      "description": "Cream appraisal-panel button; immediate hover, explicit keyboard focus and disabled feedback.",
      "html": "<div class=\"ds-appraisal-paper\"><button class=\"ds-appraisal-paper-secondary\" type=\"button\">ตรวจความแท้</button></div>",
      "css": ".ds-appraisal-paper{padding:24px;background:var(--cream,#f2e4cc);color:var(--ink,#30271f);border-radius:12px;color-scheme:light;font:16px/1.7 \"Noto Sans Thai\",sans-serif;}.ds-appraisal-paper-secondary{font:16px/1.6 \"Noto Sans Thai\",sans-serif;min-height:44px;padding:8px 16px;border:1px solid var(--paper-line,#97836a);border-radius:6px;background:transparent;color:var(--ink,#30271f);cursor:pointer;}.ds-appraisal-paper-secondary:hover:not(:disabled){background:var(--hover-wash,#e7decd);}.ds-appraisal-paper-secondary:focus-visible{outline:3px solid var(--accent,#8b3925);outline-offset:3px;}.ds-appraisal-paper-secondary:disabled{opacity:.55;cursor:not-allowed;}"
    },
    {
      "name": "Appraisal Fields",
      "kind": "input",
      "refersTo": "appraisal-input",
      "description": "Native labeled table and paper fields with the observed surface-specific palette, caret and focus. Paper variant refers to appraisal-input-paper.",
      "html": "<div class=\"ds-appraisal-table\"><label class=\"ds-appraisal-field-label\" for=\"ds-appraisal-name\">ชื่อที่ใช้ในเกม</label><input class=\"ds-appraisal-field\" id=\"ds-appraisal-name\" name=\"name\" maxlength=\"16\" autocomplete=\"nickname\"></div><div class=\"ds-appraisal-paper\"><label class=\"ds-appraisal-field-label\" for=\"ds-appraisal-value\">ราคาที่คุณประเมิน (เครดิต)</label><input class=\"ds-appraisal-field ds-appraisal-field-paper\" id=\"ds-appraisal-value\" name=\"value\" type=\"number\" min=\"0\" max=\"1000\" step=\"1\" placeholder=\"ใส่จำนวนเต็ม 0–1000\"></div>",
      "css": ".ds-appraisal-table{padding:16px;background:var(--table,#211b18);color:var(--cream,#f2e4cc);font:16px/1.7 \"Noto Sans Thai\",sans-serif;}.ds-appraisal-paper{padding:24px;background:var(--cream,#f2e4cc);color:var(--ink,#30271f);border-radius:12px;color-scheme:light;font:16px/1.7 \"Noto Sans Thai\",sans-serif;}.ds-appraisal-field-label{display:block;font-weight:600;margin-bottom:6px;}.ds-appraisal-field{box-sizing:border-box;display:block;width:100%;min-height:46px;padding:8px 12px;border:1px solid var(--bronze,#a48251);border-radius:6px;background:var(--panel,#302721);color:var(--cream,#f2e4cc);font:16px/1.7 \"Noto Sans Thai\",sans-serif;caret-color:var(--amber,#e9b765);}.ds-appraisal-field::placeholder{color:var(--muted,#c7b79c);}.ds-appraisal-field:focus-visible{outline:3px solid var(--focus,#f2ca83);outline-offset:3px;}.ds-appraisal-field::selection{background:var(--amber,#e9b765);color:var(--ink,#30271f);}.ds-appraisal-field-paper{background:var(--paper,#fffaf0);color:var(--ink,#30271f);border-color:var(--paper-line,#97836a);caret-color:var(--accent,#8b3925);}.ds-appraisal-field-paper::placeholder{color:var(--paper-muted,#67533e);}.ds-appraisal-field-paper:focus-visible{outline-color:var(--accent,#8b3925);}.ds-appraisal-field-paper::selection{background:var(--accent,#8b3925);color:var(--paper,#fffaf0);}.ds-appraisal-field:disabled{opacity:.55;cursor:not-allowed;}"
    },
    {
      "name": "Appraisal Reading Panel",
      "kind": "card",
      "refersTo": "appraisal-reading",
      "description": "Cream reading surface and viewer-known facts. This static source example uses unknown facts and deliberately omits raster art; it is not a whole desk preview.",
      "html": "<section class=\"ds-appraisal-paper\" aria-label=\"ข้อมูลสินค้า\"><h3 class=\"ds-appraisal-title\">ข้อมูลสินค้า</h3><dl class=\"ds-appraisal-facts\"><div><dt>มูลค่าจริง</dt><dd>ยังไม่รู้</dd></div><div><dt>ความแท้</dt><dd>ยังไม่ตรวจ</dd></div><div><dt>คำสาป</dt><dd>ยังไม่ทราบ</dd></div></dl><p class=\"ds-appraisal-effects\">ผลที่เป็นไปได้แยกจากผลตรวจที่คุณรู้</p></section>",
      "css": ".ds-appraisal-paper{padding:24px;background:var(--cream,#f2e4cc);color:var(--ink,#30271f);border-radius:12px;color-scheme:light;font:16px/1.7 \"Noto Sans Thai\",sans-serif;}.ds-appraisal-title{font:600 21px/1.55 \"Noto Serif Thai\",serif;text-wrap:balance;margin:0 0 12px;}.ds-appraisal-facts{display:grid;gap:8px;margin:16px 0;}.ds-appraisal-facts>div{display:grid;grid-template-columns:90px minmax(0,1fr);gap:12px;}.ds-appraisal-facts dt{color:var(--paper-muted,#67533e);}.ds-appraisal-facts dd{margin:0;font-variant-numeric:tabular-nums;}.ds-appraisal-effects{margin:0 0 12px;border-top:1px solid var(--paper-line,#97836a);padding-top:16px;max-width:70ch;}.ds-appraisal-paper::selection{background:var(--accent,#8b3925);color:var(--paper,#fffaf0);}@media(max-width:640px){.ds-appraisal-paper{padding:20px;}.ds-appraisal-facts>div{grid-template-columns:85px minmax(0,1fr);gap:8px;}}"
    },
    {
      "name": "Appraisal Stock Selection",
      "kind": "custom",
      "refersTo": "appraisal-stock-selection",
      "description": "Pressed native stock buttons with selected outline. Example item labels are placeholders; product names and quotes come from the live DTO.",
      "html": "<div class=\"ds-appraisal-table\"><div class=\"ds-appraisal-stock\" role=\"group\" aria-label=\"สินค้าของพ่อค้า\"><button class=\"ds-appraisal-stock-button\" type=\"button\" aria-pressed=\"true\">1. สินค้าชิ้นแรก</button><button class=\"ds-appraisal-stock-button\" type=\"button\" aria-pressed=\"false\">2. สินค้าชิ้นที่สอง</button></div></div>",
      "css": ".ds-appraisal-table{padding:16px;background:var(--table,#211b18);color:var(--cream,#f2e4cc);font:16px/1.7 \"Noto Sans Thai\",sans-serif;}.ds-appraisal-stock{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px;}.ds-appraisal-stock-button{font:16px/1.6 \"Noto Sans Thai\",sans-serif;min-height:44px;padding:8px 16px;border:1px solid var(--bronze,#a48251);border-radius:6px;background:transparent;color:var(--cream,#f2e4cc);cursor:pointer;}.ds-appraisal-stock-button:hover:not(:disabled){background:var(--panel,#302721);}.ds-appraisal-stock-button[aria-pressed=true]{outline:2px solid var(--amber,#e9b765);outline-offset:2px;}.ds-appraisal-stock-button:focus-visible{outline:3px solid var(--focus,#f2ca83);outline-offset:3px;}.ds-appraisal-stock-button:disabled{opacity:.55;cursor:not-allowed;}"
    },
    {
      "name": "Legacy Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Legacy auction only. Primary Button; immediate hover and explicit keyboard focus.",
      "html": "<button class=\"ds-button-primary\">ล็อกราคา</button>",
      "css": ".ds-button-primary{font:16px Tahoma, \"Noto Sans Thai\", sans-serif;line-height:1.5;min-height:44px;padding:9px 18px;border:1px solid #29251f;border-radius:4px;color:#29251f;background:transparent;cursor:pointer;background:#8b3925;border-color:#8b3925;color:#fffaf0;}.ds-button-primary:hover:not(:disabled){background:#6d2b1c;border-color:#6d2b1c;}.ds-button-primary:focus-visible{outline:3px solid #8b3925;outline-offset:4px;}.ds-button-primary:disabled{opacity:.55;cursor:not-allowed;}"
    },
