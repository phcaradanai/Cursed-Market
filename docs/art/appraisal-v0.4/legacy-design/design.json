  "narrative": {
    "northStar": "Readable auction work surface",
    "overview": "A pale warm ground, dark ink and rust commitments make the prototype easy to read while friends make timed decisions. This is the shipped provisional presentation, not an approved production identity. Human fun tests come before polished art or a larger visual system.\n\nSource authority: `src/client/styles.css`, `src/client/App.tsx` and `src/client/Relic.tsx`, checked against the built CSS in `dist/client`. The system records reusable controls and information treatments; marketplace composition remains in `.impeccable/surfaces/marketplace.md`.",
    "keyCharacteristics": [
      "Readable Thai text with generous line spacing.",
      "Flat surfaces, fine dividers and compact native controls.",
      "Explicit labels for decisions, private findings and outcomes.",
      "Static family symbols that do not reveal hidden attributes."
    ],
    "rules": [
      {
        "name": "The Legibility Rule",
        "body": "Preserve Thai line spacing and wrap user names before narrowing or clipping meaningful text.",
        "section": "typography"
      },
      {
        "name": "The Flat Surface Rule",
        "body": "Preserve the current border and tonal separation while this prototype is being tested.",
        "section": "elevation"
      },
      {
        "name": "The Property Scope Rule",
        "body": "A guarantee or inspection of one attribute never visually implies knowledge of the other attribute.",
        "section": "components"
      }
    ],
    "dos": [
      "**Do** preserve visible Thai labels, explicit focus and wrapping names.",
      "**Do** state the cost, locked state and exact scope of a decision.",
      "**Do** keep family symbols identical across hidden attribute combinations.",
      "**Do** keep additions provisional until human playtests provide evidence."
    ],
    "donts": [
      "**Don't** communicate truth, curse, readiness or errors through color alone.",
      "**Don't** expose private attributes through illustration variants.",
      "**Don't** introduce polished art, motion or a larger identity before the authorized human fun tests."
    ]
  }
}
