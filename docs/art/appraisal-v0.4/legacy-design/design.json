      "html": "<label class=\"ds-relic-choice\"><input class=\"ds-relic-radio\" type=\"radio\" name=\"ds-relic\" checked><span class=\"ds-choice-number\">ชิ้นที่ 1</span><div class=\"ds-relic\"><svg class=\"ds-symbol\" viewBox=\"0 0 64 64\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"23\" cy=\"21\" r=\"12\"/><path d=\"m31 30 22 22m-7-7 7-7m-14 0 7-7\"/></svg><h3 class=\"ds-relic-title\">กุญแจ</h3><div class=\"ds-truth\"><span>ของแท้</span><span class=\"ds-danger\">มีคำสาป</span></div></div></label>",
